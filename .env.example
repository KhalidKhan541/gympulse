# GymPulse environment variables
# Copy to .env.local and fill in real values.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Payments (Stripe)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# Database (e.g. Postgres via Prisma)
DATABASE_URL=postgresql://user:password@localhost:5432/gympulse

# Email (e.g. Resend / SMTP)
EMAIL_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=frontdesk@gympulse.fit

# Analytics (optional)
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxx
